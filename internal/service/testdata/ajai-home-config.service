# Written by ajai daemon install; ajai daemon uninstall removes it.
[Unit]
Description=ajai: applies to LinkedIn jobs on your schedule windows
Documentation=https://github.com/luizfreitas27/ajai
# The Chrome window the runs open needs the desktop session.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment="AJAI_HOME=/home/u/ajai 100%%"
Environment=XDG_DATA_HOME=/data/u
ExecStart="/opt/my apps/ajai" daemon --config "/home/u/ajai 100%%/config.yaml"
# Stopped like Ctrl-C: only the daemon gets SIGINT, its run ends cleanly and it
# closes the Chrome it opened; whatever is left after it exits is killed.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=3min
Restart=on-failure
RestartSec=30
# Another ajai daemon already runs: retrying would not help.
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
